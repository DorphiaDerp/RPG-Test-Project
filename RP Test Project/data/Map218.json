{"id":3,"name":"lady","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":true,"image":{"tileId":0,"characterName":"Frigus","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,"Lelana"]},{"code":401,"indent":0,"parameters":["...read what you want... "]},{"code":401,"indent":0,"parameters":["...education is free..."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":false}],"x":3,"y":4},
{"id":4,"name":"book","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":true,"image":{"tileId":0,"characterName":"!Flame","direction":2,"pattern":2,"characterIndex":6},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You read a passage."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\"Though the tower was tall and the land was bleak, the four "]},{"code":401,"indent":0,"parameters":["heroes traveled far and wide to take down the shadow master "]},{"code":401,"indent":0,"parameters":["who had casted everything to darkness.\""]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\"They were the only ones who were known to be capable of "]},{"code":401,"indent":0,"parameters":["facing Dolizith, the manifestation of the deepest darkest "]},{"code":401,"indent":0,"parameters":["feelings of the gods, or so he is said to be.\" "]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":false}],"x":13,"y":3},
{"id":5,"name":"book","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":true,"image":{"tileId":0,"characterName":"!Flame","direction":2,"pattern":2,"characterIndex":6},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You read a passage."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\"Extracted from the sugar mines underneath the Emerald "]},{"code":401,"indent":0,"parameters":["Forest, selperter is a sweet alternative to salt. It's like "]},{"code":401,"indent":0,"parameters":["another natural sugar that just melts in your mouth!\""]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\"Though some prefer the selperter mined out under Bogmind. "]},{"code":401,"indent":0,"parameters":["They say the sweetness lingers longer, but many find it to "]},{"code":401,"indent":0,"parameters":["be to bitter.\""]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":false}],"x":10,"y":8},
{"id":6,"name":"book","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":true,"image":{"tileId":0,"characterName":"!Flame","direction":2,"pattern":2,"characterIndex":6},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["You read a passage."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\"My momma always tried to induce fear into me by telling me "]},{"code":401,"indent":0,"parameters":["about the story of the 'Poop Fairy' who would get you if you "]},{"code":401,"indent":0,"parameters":["didn't wipe. But that tale is hardly believed anymore.\""]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["\"The legend I find more scary is the legend of the Time Fox, "]},{"code":401,"indent":0,"parameters":["Virinity. They say she keeps time in order by warping around "]},{"code":401,"indent":0,"parameters":["a lot to keep timelines in check. I know it's weird, but I "]},{"code":401,"indent":0,"parameters":["find it scary because no one should have time powers.\""]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":false}],"x":13,"y":8}
